<?xml version="1.0" encoding="utf-8"?>
<!--
    The app stores pedagogical records locally. Keep cloud backup and device
    transfer disabled until an explicit, protected backup flow is available.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
