{
  "name": "assistente-pedagogico",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check:v2-boundary": "node scripts/check-v2-boundary.mjs",
    "build": "pnpm run check:v2-boundary && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:v2-responsive": "playwright test e2e/v2-responsive.pw.ts e2e/v2-frequency-responsive.pw.ts e2e/v2-observation-flow.pw.ts --config playwright.config.ts",
    "android:sync": "node scripts/android-sync.mjs",
    "android:qa": "node scripts/android-qa.mjs",
    "android:device:check": "node scripts/android-device-check.mjs",
    "android:release": "node scripts/android-release.mjs",
    "android:release:unsigned": "node scripts/android-release.mjs --unsigned",
    "format": "prettier --write src tests"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/file-viewer": "^1.0.0",
    "@capacitor/filesystem": "^7.1.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capawesome/capacitor-torch": "^7.0.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito-sans": "^5.2.0",
    "@revenuecat/purchases-capacitor": "13.3.0",
    "jspdf": "^4.2.1",
    "lottie-web": "5.13.0",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@capacitor/cli": "^7.4.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
